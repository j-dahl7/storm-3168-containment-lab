  "actions": {
    "Validate_configuration": {
      "type": "If",
      "expression": "@and(equals(toLower(split(workflow().id, '/')[2]), toLower(parameters('expectedSubscriptionId'))), equals(toLower(parameters('resourceGroupId')), toLower(concat('/subscriptions/', parameters('expectedSubscriptionId'), '/resourceGroups/', split(workflow().id, '/')[4]))), or(equals(toLower(parameters('targetRoleScope')), toLower(parameters('resourceGroupId'))), startsWith(toLower(parameters('targetRoleScope')), concat(toLower(parameters('resourceGroupId')), '/providers/'))), equals(toLower(parameters('targetRoleAssignmentId')), toLower(concat(parameters('targetRoleScope'), '/providers/Microsoft.Authorization/roleAssignments/', last(split(parameters('targetRoleAssignmentId'), '/'))))), equals(toLower(parameters('targetRoleDefinitionId')), toLower(concat('/subscriptions/', parameters('expectedSubscriptionId'), '/providers/Microsoft.Authorization/roleDefinitions/', last(split(parameters('targetRoleDefinitionId'), '/'))))), equals(length(last(split(parameters('targetRoleAssignmentId'), '/'))), 36), equals(length(last(split(parameters('targetRoleDefinitionId'), '/'))), 36), equals(length(parameters('actorObjectId')), 36), equals(length(parameters('labId')), 36), not(contains(parameters('resourceGroupId'), '?')), not(contains(parameters('resourceGroupId'), '#')), not(contains(parameters('resourceGroupId'), '%')), not(contains(parameters('resourceGroupId'), '..')), not(contains(parameters('targetRoleScope'), '?')), not(contains(parameters('targetRoleScope'), '#')), not(contains(parameters('targetRoleScope'), '%')), not(contains(parameters('targetRoleScope'), '..')), not(contains(parameters('targetRoleAssignmentId'), '?')), not(contains(parameters('targetRoleAssignmentId'), '#')), not(contains(parameters('targetRoleAssignmentId'), '%')), not(contains(parameters('targetRoleAssignmentId'), '..')), not(contains(parameters('targetRoleDefinitionId'), '?')), not(contains(parameters('targetRoleDefinitionId'), '#')), not(contains(parameters('targetRoleDefinitionId'), '%')), not(contains(parameters('targetRoleDefinitionId'), '..')))",
      "actions": {
        "Validate_configuration_validated": {
          "type": "Compose",
          "inputs": "configuration_valid"
        }
      },
      "else": {
        "actions": {
          "Validate_configuration_rejected": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "ConfigurationRejected",
                "message": "Resource identifiers do not describe the configured lab subscription and group."
              }
            }
          }
        }
      },
      "runAfter": {}
    },
    "Read_group": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "@concat('https://management.azure.com', parameters('resourceGroupId'), '?api-version=2022-09-01')",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://management.azure.com/"
        },
        "retryPolicy": {
          "type": "none"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      },
      "runAfter": {
        "Validate_configuration": [
          "Succeeded"
        ]
      }
    },
    "Verify_group_ownership": {
      "type": "If",
      "expression": "@and(equals(toLower(string(body('Read_group')?['id'])), toLower(parameters('resourceGroupId'))), equals(body('Read_group')?['tags']?['storm3168LabId'], parameters('labId')))",
      "actions": {
        "Verify_group_ownership_validated": {
          "type": "Compose",
          "inputs": "group_owned"
