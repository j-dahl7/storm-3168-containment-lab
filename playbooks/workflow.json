            "inputs",
            "outputs"
          ]
        }
      },
      "runAfter": {
        "Verify_group_ownership": [
          "Succeeded"
        ]
      }
    },
    "Handle_assignment_read": {
      "type": "If",
      "expression": "@equals(outputs('Read_assignment')?['statusCode'], 404)",
      "actions": {
        "Record_already_absent": {
          "type": "Compose",
          "inputs": {
            "status": "already_absent_access_unverified",
            "roleAssignmentId": "@parameters('targetRoleAssignmentId')",
            "checkedAt": "@utcNow()"
          }
        },
        "Finish_already_absent": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Record_already_absent": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {
          "Require_assignment_read_success": {
            "type": "If",
            "expression": "@equals(outputs('Read_assignment')?['statusCode'], 200)",
            "actions": {
              "Assignment_read_ok": {
                "type": "Compose",
                "inputs": "assignment_read_succeeded"
              }
            },
            "else": {
              "actions": {
                "Classify_assignment_forbidden": {
                  "type": "If",
                  "expression": "@equals(outputs('Read_assignment')?['statusCode'], 403)",
                  "actions": {
                    "Record_assignment_forbidden": {
                      "type": "Compose",
                      "inputs": {
                        "status": "assignment_forbidden"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Classify_assignment_throttled": {
                        "type": "If",
                        "expression": "@equals(outputs('Read_assignment')?['statusCode'], 429)",
                        "actions": {
                          "Record_assignment_throttled": {
                            "type": "Compose",
                            "inputs": {
                              "status": "assignment_throttled"
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "Classify_assignment_timeout": {
                              "type": "If",
                              "expression": "@equals(actions('Read_assignment')?['status'], 'TimedOut')",
                              "actions": {
                                "Record_assignment_timeout": {
                                  "type": "Compose",
                                  "inputs": {
                                    "status": "assignment_timeout"
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Record_assignment_unknown": {
                                    "type": "Compose",
                                    "inputs": {
                                      "status": "assignment_unknown"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "Stop_unknown_assignment": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "AssignmentReadUnknown",
                      "message": "Only 404 proves prior absence; no mutation was attempted."
                    }
                  },
                  "runAfter": {
                    "Classify_assignment_forbidden": [
                      "Succeeded"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "runAfter": {
        "Read_assignment": [
          "Succeeded",
          "Failed",
          "TimedOut"
        ]
      }
    },
    "Verify_assignment": {
      "type": "If",
      "expression": "@and(equals(toLower(string(body('Read_assignment')?['id'])), toLower(parameters('targetRoleAssignmentId'))), equals(toLower(string(body('Read_assignment')?['properties']?['principalId'])), toLower(parameters('actorObjectId'))), equals(toLower(string(body('Read_assignment')?['properties']?['roleDefinitionId'])), toLower(parameters('targetRoleDefinitionId'))), equals(toLower(string(body('Read_assignment')?['properties']?['scope'])), toLower(parameters('targetRoleScope'))), equals(body('Read_assignment')?['properties']?['principalType'], 'ServicePrincipal'))",
      "actions": {
        "Verify_assignment_validated": {
          "type": "Compose",
          "inputs": "target_assignment_matches"
        }
      },
      "else": {
        "actions": {
          "Verify_assignment_rejected": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "WrongAssignment",
                "message": "Principal, role, scope or resource ID did not exactly match the configured target."
              }
            }
          }
        }
      },
      "runAfter": {
        "Handle_assignment_read": [
          "Succeeded"
        ]
      }
    },
    "Dry_run_gate": {
      "type": "If",
      "expression": "@equals(parameters('dryRun'), true)",
      "actions": {
        "Record_dry_run": {
          "type": "Compose",
          "inputs": {
            "status": "dry_run_no_mutation",
            "roleAssignmentId": "@parameters('targetRoleAssignmentId')",
            "actorObjectId": "@parameters('actorObjectId')",
            "checkedAt": "@utcNow()",
            "workflowRunId": "@workflow().run.name"
          }
        },
        "End_dry_run": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Record_dry_run": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Verify_assignment": [
          "Succeeded"
        ]
      }
    },
    "Confirm_execution": {
      "type": "If",
      "expression": "@and(equals(parameters('dryRun'), false), equals(parameters('executionConfirmation'), 'REMOVE_CONFIGURED_LAB_ROLE'))",
      "actions": {
        "Confirm_execution_validated": {
          "type": "Compose",
          "inputs": "execution_confirmed"
        }
      },
      "else": {
        "actions": {
          "Confirm_execution_rejected": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "ExecutionNotConfirmed",
                "message": "Explicit execution confirmation is absent; no deletion was attempted."
              }
            }
          }
        }
      },
      "runAfter": {
        "Dry_run_gate": [
          "Succeeded"
        ]
      }
    },
    "Read_group_again": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "@concat('https://management.azure.com', parameters('resourceGroupId'), '?api-version=2022-09-01')",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://management.azure.com/"
        },
        "retryPolicy": {
          "type": "none"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      },
      "runAfter": {
        "Confirm_execution": [
          "Succeeded"
        ]
      }
    },
