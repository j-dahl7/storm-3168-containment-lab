    "Read_after_delete": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "@concat('https://management.azure.com', parameters('targetRoleAssignmentId'), '?api-version=2022-04-01')",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://management.azure.com/"
        },
        "retryPolicy": {
          "type": "none"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      },
      "runAfter": {
        "Delete_configured_assignment": [
          "Succeeded",
          "Failed",
          "TimedOut"
        ]
      }
    },
    "Confirm_assignment_absent": {
      "type": "If",
      "expression": "@equals(outputs('Read_after_delete')?['statusCode'], 404)",
      "actions": {
        "Check_delete_acknowledgment": {
          "type": "If",
          "expression": "@or(equals(outputs('Delete_configured_assignment')?['statusCode'], 200), equals(outputs('Delete_configured_assignment')?['statusCode'], 202), equals(outputs('Delete_configured_assignment')?['statusCode'], 204))",
          "actions": {
            "Record_result": {
              "type": "Compose",
              "inputs": {
                "status": "role_assignment_removed_access_unverified",
                "roleAssignmentId": "@parameters('targetRoleAssignmentId')",
                "actorObjectId": "@parameters('actorObjectId')",
                "checkedAt": "@utcNow()",
                "workflowRunId": "@workflow().run.name",
                "nextStep": "Run the independent fixed-token probe. This does not prove resource access is denied."
              }
            }
          },
          "else": {
            "actions": {
              "Record_absent_after_unconfirmed_delete": {
                "type": "Compose",
                "inputs": {
                  "status": "assignment_absent_delete_unconfirmed",
                  "roleAssignmentId": "@parameters('targetRoleAssignmentId')",
                  "checkedAt": "@utcNow()"
