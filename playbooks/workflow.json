{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "expectedSubscriptionId": {
      "type": "String"
    },
    "labId": {
      "type": "String"
    },
    "resourceGroupId": {
      "type": "String"
    },
    "actorObjectId": {
      "type": "String"
    },
    "targetRoleAssignmentId": {
      "type": "String"
    },
    "targetRoleDefinitionId": {
      "type": "String"
    },
    "targetRoleScope": {
      "type": "String"
    },
    "dryRun": {
      "type": "Bool",
      "defaultValue": true
    },
    "executionConfirmation": {
      "type": "String",
      "defaultValue": ""
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {}
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
