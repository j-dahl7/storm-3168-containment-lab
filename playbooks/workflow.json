              }
            }
          }
        }
      },
      "else": {
        "actions": {
          "Classify_verification_forbidden": {
            "type": "If",
            "expression": "@equals(outputs('Read_after_delete')?['statusCode'], 403)",
            "actions": {
              "Record_verification_forbidden": {
                "type": "Compose",
                "inputs": {
                  "status": "verification_forbidden"
                }
              }
            },
            "else": {
              "actions": {
                "Classify_verification_throttled": {
                  "type": "If",
                  "expression": "@equals(outputs('Read_after_delete')?['statusCode'], 429)",
                  "actions": {
                    "Record_verification_throttled": {
                      "type": "Compose",
                      "inputs": {
                        "status": "verification_throttled"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Classify_verification_timeout": {
                        "type": "If",
                        "expression": "@equals(actions('Read_after_delete')?['status'], 'TimedOut')",
                        "actions": {
                          "Record_verification_timeout": {
                            "type": "Compose",
                            "inputs": {
                              "status": "verification_timeout"
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "Record_verification_unknown": {
                              "type": "Compose",
                              "inputs": {
                                "status": "verification_unknown"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "Confirm_assignment_absent_rejected": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "AbsenceNotVerified",
                "message": "The exact assignment did not return HTTP 404. Do not mark containment successful."
              }
            },
            "runAfter": {
              "Classify_verification_forbidden": [
                "Succeeded"
              ]
            }
          }
        }
      },
      "runAfter": {
        "Read_after_delete": [
          "Succeeded",
          "Failed",
          "TimedOut"
        ]
      }
    }
  },
  "outputs": {}
}
