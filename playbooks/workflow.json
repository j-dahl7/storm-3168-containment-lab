      "type": "If",
      "expression": "@and(equals(toLower(string(body('Read_group_again')?['id'])), toLower(parameters('resourceGroupId'))), equals(body('Read_group_again')?['tags']?['storm3168LabId'], parameters('labId')))",
      "actions": {
        "Recheck_group_ownership_validated": {
          "type": "Compose",
          "inputs": "group_still_owned"
        }
      },
      "else": {
        "actions": {
          "Recheck_group_ownership_rejected": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "OwnershipChanged",
                "message": "The lab ownership tag changed; no deletion was attempted."
              }
            }
          }
        }
      },
      "runAfter": {
        "Read_group_again": [
          "Succeeded"
        ]
      }
    },
    "Read_assignment_again": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "@concat('https://management.azure.com', parameters('targetRoleAssignmentId'), '?api-version=2022-04-01')",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://management.azure.com/"
        },
        "retryPolicy": {
          "type": "none"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      },
      "runAfter": {
        "Recheck_group_ownership": [
          "Succeeded"
        ]
      }
    },
    "Recheck_assignment": {
      "type": "If",
      "expression": "@and(equals(toLower(string(body('Read_assignment_again')?['id'])), toLower(parameters('targetRoleAssignmentId'))), equals(toLower(string(body('Read_assignment_again')?['properties']?['principalId'])), toLower(parameters('actorObjectId'))), equals(toLower(string(body('Read_assignment_again')?['properties']?['roleDefinitionId'])), toLower(parameters('targetRoleDefinitionId'))), equals(toLower(string(body('Read_assignment_again')?['properties']?['scope'])), toLower(parameters('targetRoleScope'))), equals(body('Read_assignment_again')?['properties']?['principalType'], 'ServicePrincipal'))",
      "actions": {
        "Recheck_assignment_validated": {
          "type": "Compose",
          "inputs": "target_assignment_still_matches"
        }
