      "else": {
        "actions": {
          "Recheck_assignment_rejected": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "AssignmentChanged",
                "message": "The target assignment changed; no deletion was attempted."
              }
            }
          }
        }
      },
      "runAfter": {
        "Read_assignment_again": [
          "Succeeded"
        ]
      }
    },
    "Delete_configured_assignment": {
      "type": "Http",
      "inputs": {
        "method": "DELETE",
        "uri": "@concat('https://management.azure.com', parameters('targetRoleAssignmentId'), '?api-version=2022-04-01')",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://management.azure.com/"
        },
        "retryPolicy": {
          "type": "none"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      },
      "runAfter": {
        "Recheck_assignment": [
          "Succeeded"
        ]
      }
