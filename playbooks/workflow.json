            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "WrongLabGroup",
                "message": "The resource group ID or server-side ownership tag did not match."
              }
            }
          }
        }
      },
      "runAfter": {
        "Read_group": [
          "Succeeded"
        ]
      }
